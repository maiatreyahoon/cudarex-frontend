# No keys needed. Copy to .env only for optional model generation.
NEBIUS_API_KEY=
# Copy an exact NVIDIA Nemotron model ID available in your Nebius account.
# Availability varies; no model is assumed to be available or tested here.
NEBIUS_MODEL=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Optional absolute SQLite path. Default: backend/data/cudarex.sqlite3
# CUDAREX_DB=
